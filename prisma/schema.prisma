// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
/// A Z-Assist chat user, registered at /agent with just a first name.
/// The personal access token (ZA-XXXXXX) restores the same account — and
/// every conversation owned by it — on any device.
model AssistUser {
  id         String   @id @default(cuid())
  name       String
  token      String   @unique
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
}

model AssistConversation {
  id        String   @id @default(cuid())
  token     String   @unique
  /// Owning chat user's personal access token (null = legacy/anonymous threads).
  userToken String?
  title     String?
  messages  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userToken, updatedAt])
}

model SiteData {
  key       String   @id
  payload   String
  changeLog String   @default("[]")
  updatedAt DateTime @updatedAt
}

/// Z-Assist trust layer — per-reply feedback (thumbs up/down) captured at
/// /agent. A thumbs-down (or a flagged verification verdict) seeds the
/// self-learning queue. Additive table: never touches existing chats.
model AssistFeedback {
  id                String   @id @default(cuid())
  /// Owning chat user's ZA- token (null = anonymous surface).
  userToken         String?
  conversationToken String?
  /// "up" | "down"
  rating            String
  /// The user question + the assistant answer being rated (trimmed).
  question          String
  answer            String
  /// Optional free-text reason from the user.
  reason            String?
  /// Verification verdict at reply time: "verified" | "flagged" | "skip".
  verdict           String?
  createdAt         DateTime @default(now())

  @@index([createdAt])
  @@index([rating])
}

/// Z-Assist self-learning store. When the engine can't ground an answer or a
/// user downvotes one, the question lands here as "pending"; staff review it
/// at /agent (staff mode) and approve a docs-cited answer. Approved entries
/// are injected into future prompts, so the agent measurably improves with
/// time — while staying facts-only from official z.ai / zcode.z.ai docs.
model AssistLearnEntry {
  id         String    @id @default(cuid())
  /// Normalized question fingerprint (lowercase, stopwords stripped) for
  /// dedupe + similarity matching.
  qKey       String
  question   String
  /// Draft or staff-approved answer (markdown; must cite official pages).
  answer     String    @default("")
  /// "auto" (verification flag / engine refusal) | "feedback" (thumbs-down) | "staff".
  origin     String    @default("auto")
  /// "pending" | "approved" | "rejected".
  status     String    @default("pending")
  /// Space-separated official source URLs backing the approved answer.
  sourceUrls String    @default("")
  /// Why it landed here (verification issues / user reason / staff note).
  note       String?
  /// How many times the approved answer has been used as prompt context.
  hits       Int       @default(0)
  lastHitAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([status, updatedAt])
  @@index([qKey])
}

model SyncRun {
  id        String   @id @default(cuid())
  status    String
  summary   String?
  /// What kicked the run off ("hourly" | "boot" | "manual").
  trigger   String   @default("hourly")
  /// JSON array of top-level payload sections the run changed (changed runs only).
  sections  String   @default("[]")
  createdAt DateTime @default(now())
}

/// A linked Telegram chat that receives event/announcement alerts.
/// prefs: JSON {"golden":bool,"windows":bool,"announcements":bool}
model TelegramChat {
  id        String   @id @default(cuid())
  chatId    String   @unique
  title     String?
  prefs     String   @default("{\"golden\":true,\"windows\":true,\"announcements\":true}")
  createdAt DateTime @default(now())
}

/// A visitor's own Telegram bot paired with Z-Assist.
/// Flow: portal posts bot token -> we verify (getMe) -> owner sends
/// "/start <pairCode>" to the bot -> status flips to active and every
/// text message is answered by the Z-Assist engine (5 questions/day,
/// then a free handoff to the web chat via conversationToken).
model ZAssistBot {
  id        String   @id @default(cuid())
  /// Browser-generated secret scoping portal UI visibility (never the bot token).
  ownerKey  String   @default("")
  botToken  String   @unique
  botId     String
  botUsername String
  pairCode  String
  /// "pending" (awaiting /start <pairCode>) | "active" (paired chat).
  status    String   @default("pending")
  ownerChatId  String?
  ownerTitle   String?
  ownerUserId  String?
  /// AssistConversation token — the same thread continues on the web chat.
  conversationToken String?
  /// Daily free-question counter (resets at midnight SGT).
  questionsDate  String?
  questionsToday Int     @default(0)
  totalReplies   Int     @default(0)
  lastMessageAt  DateTime?
  lastError      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([ownerKey])
}

/// Secret IDE-endpoint keys issued behind the password gate at /endpoint.
/// A key authenticates calls from IDE tools (zcode / Claude Code) against
/// the OpenAI-compatible (/api/endpoint/v1/chat/completions) and
/// Anthropic-compatible (/api/endpoint/v1/messages) Z-Assist routes, and
/// mirrors each thread into a shared AssistConversation so the chat
/// continues on the web via the resume token.
model EndpointKey {
  id        String    @id @default(cuid())
  key       String    @unique
  label     String    @default("IDE tools")
  /// AssistConversation token the IDE thread mirrors into (web-continuable).
  conversationToken String?
  callCount Int       @default(0)
  lastUsedAt DateTime?
  lastModel String?
  createdAt DateTime  @default(now())
}

/// zScanner v4 — durable scan snapshots addressed by a user-saved token.
/// A token lets the user re-scan later and diff: fixed / still open / new.
/// Rows hold scrubbed report JSON only — user GitHub tokens never land here.
model ScanSnapshot {
  id         String   @id @default(cuid())
  /// Public handle: ZSC-XXXX-XXXX-XXXX-XXXX (80-bit, unguessable).
  token      String   @unique
  /// "security" | "geo-seo" | "qa" | "code" — diff requires an exact match.
  scanner    String
  /// Comparison identity: hostname / owner-repo / "pasted-source".
  targetKey  String
  /// Display target as scanned (normalized URL or github.com/owner/repo).
  target     String
  score      Int
  grade      String
  /// Full scrubbed report JSON (findings incl. evidence, verification…).
  reportJson String
  createdAt  DateTime @default(now())

  @@index([scanner, targetKey, createdAt])
  @@index([createdAt])
}

/// My Dev Blog — mini articles about the projects built for/around Z.AI.
/// Anyone can read; only the paired agent (Bearer token) can publish.
model BlogPost {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  /// Short teaser shown on the blog index (plain text, 1-2 sentences).
  excerpt   String
  /// Markdown-lite body (headings, bold, code fences, lists, links).
  body      String
  /// Comma-separated lowercase tags, e.g. "z.ai, agents, open-source".
  tags      String?
  /// Display author ("Rommark" by default, or the pushing agent's name).
  author    String?
  /// "seed" = shipped with the portal, "agent" = pushed via the API.
  source    String   @default("agent")
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, createdAt])
}

/// Singleton Bearer token that authorizes POST/DELETE on /api/blog.
/// Auth order: env BLOG_PUSH_TOKEN first, then this DB row.
model BlogToken {
  id        String   @id @default(cuid())
  token     String   @unique
  createdAt DateTime @default(now())
}
