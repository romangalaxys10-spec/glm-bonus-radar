# GLM Mail Server — smarthost credentials (outbound relay).
# Copy this file to relay.env and fill in real values; the auto-flush thread
# retries the queue every 5 minutes, so delivery starts automatically.
#
# Why a smarthost is required here:
#   - the sandbox firewall blocks ALL outbound TCP/25 (direct-to-MX impossible)
#   - TCP/587 + 465 egress IS open -> authenticated submission works
#   - space-z.ai DNS is platform-controlled -> we cannot publish SPF/DKIM/MX
#
# Any of these providers works (fill ONE):
#   GMX    : MAIL_SMARTHOST=mail.gmx.net      MAIL_SMARTHOST_PORT=587  MAIL_SMARTHOST_MODE=starttls
#   Gmail  : MAIL_SMARTHOST=smtp.gmail.com    MAIL_SMARTHOST_PORT=587  (use an App Password)
#   Zoho   : MAIL_SMARTHOST=smtp.zoho.com     MAIL_SMARTHOST_PORT=587
#   Outlook: MAIL_SMARTHOST=smtp-mail.outlook.com MAIL_SMARTHOST_PORT=587
#
# NOTE: some providers only allow a From address matching the account
# (GMX/Outlook/Gmail do). Providers such as Brevo/SendGrid can send with a
# custom From after verifying the sender/domain.

MAIL_SMARTHOST=mail.gmx.net
MAIL_SMARTHOST_PORT=587
MAIL_SMARTHOST_MODE=starttls
MAIL_SMARTHOST_USER=your-login@gmx.com
MAIL_SMARTHOST_PASS=your-password-or-app-password
